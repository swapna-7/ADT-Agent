# Copy to mac/.env before ./build.sh to bundle into the app, or place the same
# file at ~/Library/Application Support/ADT Agent/.env after install.
API_BASE=https://vizhi.rexcybersolutions.com

# Optional: bake an org enrollment code into the build so the agent registers itself with no
# prompt. Normally supplied by the generated installer as `--install --code VZ-XXXX-XXXX-XXXX`.
ENROLLMENT_CODE=

# Written by the agent after enrollment; do not set by hand.
ENDPOINT_ID=
DEVICE_TOKEN=

# Deprecated: pre-enrollment identity. Honoured so already-deployed agents keep reporting.
USER_ID=

# Metrics and software inventory are still written straight to Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Schedules (seconds)
INTERVAL_SECONDS=900
SOFTWARE_REFRESH_SECONDS=21600
COMMAND_POLL_SECONDS=20
COMMAND_TIMEOUT_SECONDS=60
UPDATE_SCAN_SECONDS=21600
PATCH_POLL_SECONDS=30

# Self-update (default on). config.json AGENT_AUTO_UPDATE wins over this .env value.
AGENT_AUTO_UPDATE=1
AUTO_UPDATE_SECONDS=21600

VERBOSE=0
CONSOLE_LOG=1
