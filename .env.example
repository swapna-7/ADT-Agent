# Optional: if empty, app shows popup on first run and stores USER_ID in %LOCALAPPDATA%\\adt-agent\\config.json
USER_ID=

# Optional: defaults to USER_ID, used for commands.endpoint filter
ENDPOINT_ID=

# Optional: if set, metrics are pushed to Supabase and command polling is enabled
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional
INTERVAL_SECONDS=900
SOFTWARE_REFRESH_SECONDS=21600
COMMAND_POLL_SECONDS=20
COMMAND_TIMEOUT_SECONDS=60

# Verbose runtime diagnostics
VERBOSE=1

# Write logs to console as well as file (1/0)
CONSOLE_LOG=1
