# Not required for production agents. The Vizhi URL is baked in at build time
# (VIZHI_API_BASE → api_config.py). Enrollment writes config.json.
# Optional interval overrides only — never put secrets here.

# INTERVAL_SECONDS=900
# SOFTWARE_REFRESH_SECONDS=21600
# COMMAND_POLL_SECONDS=20
# UPDATE_SCAN_SECONDS=21600
# PATCH_POLL_SECONDS=30
# AUTO_UPDATE_SECONDS=21600
# AGENT_AUTO_UPDATE=1
# VERBOSE=0
# CONSOLE_LOG=1
